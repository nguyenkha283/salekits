# Copy file này thành .env.local (chạy local) hoặc cấu hình trong
# Vercel Project Settings > Environment Variables (khi deploy).

# URL Web App Apps Script (Deploy > New deployment > Web app) dùng để
# tạo cấu trúc folder Drive từ trang /khoi-tao-du-an.
VITE_DRIVE_WEBAPP_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec

# Địa chỉ app video call "Linh" (repo mesh-avatar), nhúng qua iframe ở trang chi tiết dự án.
VITE_VIDEO_CALL_URL=http://localhost:8080/
